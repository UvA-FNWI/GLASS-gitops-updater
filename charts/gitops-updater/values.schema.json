{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["hostname", "ingressClass", "image", "tag", "clusterIssuer", "config", "providers"],
  "properties": {
    "hostname": {
      "type": "string",
      "minLength": 1
    },
    "ingressClass": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "clusterIssuer": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "secretPath", "handler", "provider"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "secretPath": { "type": "string", "minLength": 1 },
          "handler": { "type": "string", "enum": ["argocd", "template"] },
          "provider": { "type": "string", "minLength": 1 },
          "mapping": { "type": "string" },
          "paths": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "branch", "type", "tokenPath"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["GitHub", "GitLab"] },
          "tokenPath": { "type": "string", "minLength": 1 },
          "repository": { "type": "string" },
          "project": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "GitHub" } } },
            "then": { "required": ["repository"] }
          },
          {
            "if": { "properties": { "type": { "const": "GitLab" } } },
            "then": { "required": ["project", "url"] }
          }
        ]
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretStoreRef": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string" }
          }
        }
      }
    },
    "azure": {
      "type": "object",
      "properties": {
        "mountPath": { "type": "string", "minLength": 1 }
      },
      "required": ["mountPath"]
    }
  },
  "additionalProperties": true
}
