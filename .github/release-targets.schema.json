{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FNWI gitops-updater release targets",
  "type": "object",
  "additionalProperties": false,
  "required": ["registries", "rollout"],
  "properties": {
    "registries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "host"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "host": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          }
        }
      }
    },
    "rollout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "config", "secret"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://.+" },
          "config": { "type": "string", "minLength": 1 },
          "secret": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
